generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationType { DIRECT GROUP CHANNEL }
enum MemberRole { MEMBER MODERATOR ADMIN OWNER }
enum SubscriptionStatus { TRIALING ACTIVE PAST_DUE CANCELED EXPIRED }
enum UploadStatus { INITIATED COMPLETED ABORTED EXPIRED }
enum BotStatus { ACTIVE DISABLED }

type Json

model User {
  id            String         @id @default(cuid())
  username      String         @unique
  displayName   String
  passwordHash  String
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  devices       Device[]
  memberships   Membership[]
  messages      Message[]
  subscriptions Subscription[]
  bots          Bot[]
  uploads       FileUpload[]
}

model Device {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  identityKey     String
  signedPreKey    String
  signedPreKeySig String
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  preKeys         PreKey[]
  @@index([userId])
}

model PreKey {
  id       String   @id @default(cuid())
  deviceId String
  device   Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  key      String
  usedAt   DateTime?
  @@index([deviceId, usedAt])
}

model Conversation {
  id          String           @id @default(cuid())
  type        ConversationType
  title       String?
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  memberships Membership[]
  messages    Message[]
  uploads     FileUpload[]
  bots        Bot[]
  @@index([updatedAt])
}

model Membership {
  conversationId String
  userId         String
  role           MemberRole   @default(MEMBER)
  joinedAt       DateTime     @default(now())
  mutedUntil     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  senderId        String
  senderDeviceId  String
  clientMessageId String
  ciphertext      String
  nonce           String
  algorithm       String       @default("xchacha20-poly1305")
  replyToId       String?
  expiresAt       DateTime?
  createdAt       DateTime     @default(now())
  editedAt        DateTime?
  deletedAt       DateTime?
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User         @relation(fields: [senderId], references: [id], onDelete: Restrict)
  @@unique([senderDeviceId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([expiresAt])
}

model Plan {
  id               String         @id
  name             String
  monthlyPriceCents Int
  maxFileBytes     BigInt
  maxGroupMembers  Int
  maxDevices       Int
  maxBots          Int
  storageBytes     BigInt
  features         Json
  subscriptions    Subscription[]
  createdAt        DateTime       @default(now())
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  planId               String
  status               SubscriptionStatus @default(TRIALING)
  provider             String?
  providerCustomerId   String?
  providerSubscriptionId String?          @unique
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  @@index([userId, status, currentPeriodEnd])
}

model FileUpload {
  id             String       @id @default(cuid())
  uploaderId     String
  conversationId String
  objectKey      String       @unique
  multipartId    String?
  filename       String
  contentType    String
  sizeBytes      BigInt
  encrypted      Boolean      @default(true)
  sha256         String?
  status         UploadStatus @default(INITIATED)
  parts          Int          @default(0)
  createdAt      DateTime     @default(now())
  completedAt    DateTime?
  expiresAt      DateTime
  uploader       User         @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([uploaderId, status])
  @@index([conversationId, createdAt])
}

model Bot {
  id             String    @id @default(cuid())
  ownerId        String
  conversationId  String?
  username       String    @unique
  displayName    String
  webhookUrl     String?
  tokenHash      String    @unique
  status         BotStatus @default(ACTIVE)
  permissions    Json
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  owner          User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  @@index([ownerId, status])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}
